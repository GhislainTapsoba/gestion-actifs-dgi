    <!--
        Added the constraints for entity Bordereau.
    -->
    <changeSet id="20260910221034-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="transfert_id"
                                 baseTableName="bordereau"
                                 constraintName="fk_bordereau__transfert_id"
