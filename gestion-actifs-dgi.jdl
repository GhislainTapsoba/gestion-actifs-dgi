// Modèle JDL - Application de gestion des actifs informatiques (DGI)
// Conforme au dictionnaire de données et au cahier des charges

// ─────────────────────────────────────────────────────────────────────────────
// ENTITÉS
// ─────────────────────────────────────────────────────────────────────────────

// Entité centrale : Equipement (= Actif dans l'implémentation JHipster)
// Attributs conformes au dictionnaire (coquilles corrigées)
entity Actif {
  codeInventaire    String required unique   // codeIventaire corrigé
  designation       String required
  marque            String
  modele            String                   // "model" corrigé
  numeroSerie       String
  codeBarre         String
  type              TypeActif required
  etat              StatutActif required
  localisation      String
  dateAcquisition   LocalDate
  valeurAcquisition Double
}

// CategorieMateriel — classification des équipements
entity CategorieMateriel {
  libelle     String required
  description String
}

// Service — structure DGI (origine/destinataire des transferts)
entity ServiceDgi {
  nomService  String required
  chefService String
}

// Agent — personne physique rattachée à un service
entity Agent {
  nom    String required
  prenom String required
}

// Affectation — attribution d'actifs à un agent/service
entity Affectation {
  dateAffectation LocalDate required
  motif           String
  dateRestitution LocalDate
}

// AffectationActif — classe association Affectation ↔ Actif
entity AffectationActif {
  observation String
  statut      StatutAffectation required
}

// Transfert — mouvement d'actifs entre services
entity Transfert {
  dateTransfert    LocalDate required
  statut           StatutTransfert required
  commentaireRejet String
  dateTraitement   LocalDate
}

// TransfertActif — classe association Transfert ↔ Actif
entity TransfertActif {
  observation String
}

// Bordereau — document officiel justificatif
entity Bordereau {
  numero           String required
  dateEmission     LocalDate required
  typeBordereau    TypeBordereau required
  statutValidation StatutBordereau required
  dateValidation   LocalDate
}

// Maintenance — opération de maintenance sur un actif
entity Maintenance {
  typeMaintenance TypeMaintenance required
  datePanne       LocalDate
  statut          StatutMaintenance required
  compteRendu     TextBlob
  dateCloture     LocalDate
}

// PlanningMaintenance — planification des maintenances
entity PlanningMaintenance {
  datePrevue   LocalDate required
  periodicite  String
  statut       StatutPlanning required
  description  String
}

// Intervention — intervention technique liée à une panne
entity Intervention {
  dateDeclaration  LocalDate required
  typeIntervention TypeIntervention required
  statut           StatutIntervention required
  description      String
}

// Panne — anomalie signalée sur un actif
entity Panne {
  description     String required
  dateDeclaration LocalDate required
  statutPanne     StatutPanne required
}

// Recensement — campagne d'inventaire physique
entity Recensement {
  dateDebut LocalDate required
  dateFin   LocalDate
  statut    StatutRecensement required
}

// EquipementRecensement — classe association Actif ↔ Recensement
entity EquipementRecensement {
  etatConstate        EtatMateriel required
  dateConstat         LocalDate required
  emplacementConstate String
  anomalieConstatee   Boolean
}

// Inventaire — import de fichier d'inventaire externe
entity Inventaire {
  nomFichier  String required
  dateImport  LocalDate required
}

// HistoriqueAction — journal de traçabilité
entity HistoriqueAction {
  dateAction    ZonedDateTime required
  typeAction    TypeMouvement required
  entiteCiblee  String
  ancienneValeur String
  nouvelleValeur String
}

// Fournisseur
entity Fournisseur {
  nom       String required
  contact   String
  email     String
  telephone String
}

// Contrat — contrat de garantie ou de maintenance
entity Contrat {
  typeContrat TypeContrat required
  reference   String
  dateDebut   LocalDate
  dateFin     LocalDate required
}

// ─────────────────────────────────────────────────────────────────────────────
// ÉNUMÉRATIONS
// ─────────────────────────────────────────────────────────────────────────────

enum TypeActif {
  POSTE_TRAVAIL, IMPRIMANTE, SERVEUR, RESEAU, PERIPHERIQUE
}

enum StatutActif {
  EN_SERVICE, EN_MAINTENANCE, REFORME, PERDU_VOLE
}

// EtatMateriel — état physique constaté (recensement)
enum EtatMateriel {
  NEUF, EN_SERVICE, EN_PANNE, EN_MAINTENANCE, REFORME
}

enum StatutAffectation {
  ACTIVE, CLOTUREE
}

enum StatutTransfert {
  EN_ATTENTE, VALIDE, REJETE
}

enum TypeBordereau {
  AFFECTATION, TRANSFERT
}

enum StatutBordereau {
  EN_ATTENTE, VALIDE, REJETE
}

enum TypeMaintenance {
  PREVENTIVE, CORRECTIVE
}

enum StatutMaintenance {
  OUVERTE, EN_COURS, CLOTUREE
}

enum StatutPlanning {
  PLANIFIER, EN_COURS, TERMINER, ANNULER
}

enum TypeIntervention {
  PREVENTIVE, CORRECTIVE
}

enum StatutIntervention {
  EN_COURS, CLOTUREE, ANNULEE
}

enum StatutPanne {
  SIGNALEE, EN_COURS, RESOLUE
}

enum StatutRecensement {
  PLANIFIER, EN_COURS, CLOTUREE
}

enum TypeContrat {
  GARANTIE, MAINTENANCE
}

enum TypeMouvement {
  CREATION, MODIFICATION, SUPPRESSION, AFFECTATION, TRANSFERT, MAINTENANCE
}

// ─────────────────────────────────────────────────────────────────────────────
// RELATIONS
// ─────────────────────────────────────────────────────────────────────────────

relationship ManyToOne {
  // Actif → CategorieMateriel (chaque actif appartient à une catégorie)
  Actif{categorie required} to CategorieMateriel

  // Agent → ServiceDgi
  Agent{service required} to ServiceDgi

  // Agent → User (compte applicatif lié à l'agent)
  Agent{utilisateur} to User with builtInEntity

  // Affectation → Agent (un agent réalise l'affectation)
  Affectation{agent required} to Agent

  // AffectationActif → Affectation + Actif
  AffectationActif{affectation required} to Affectation
  AffectationActif{actif required} to Actif

  // Transfert → ServiceDgi (origine et destinataire)
  Transfert{serviceOrigine required} to ServiceDgi
  Transfert{serviceDestinataire required} to ServiceDgi
  Transfert{demandeur} to User with builtInEntity
  Transfert{validateur} to User with builtInEntity

  // TransfertActif → Transfert + Actif
  TransfertActif{transfert required} to Transfert
  TransfertActif{actif required} to Actif

  // Bordereau → Transfert ou Affectation + émetteur
  Bordereau{transfert} to Transfert
  Bordereau{affectation} to Affectation
  Bordereau{emetteur required} to User with builtInEntity

  // Maintenance → Actif + technicien
  Maintenance{actif required} to Actif
  Maintenance{technicien} to User with builtInEntity

  // Intervention → Panne
  Intervention{panne required} to Panne

  // Panne → Actif
  Panne{actif required} to Actif

  // EquipementRecensement → Recensement + Actif
  EquipementRecensement{recensement required} to Recensement
  EquipementRecensement{actif required} to Actif

  // Inventaire → Actif (optionnel)
  Inventaire{actif} to Actif

  // Contrat → Fournisseur + Actif
  Contrat{fournisseur required} to Fournisseur
  Contrat{actif} to Actif

  // HistoriqueAction → User
  HistoriqueAction{utilisateur required} to User with builtInEntity
}

relationship ManyToMany {
  // PlanningMaintenance ↔ Intervention (many-to-many selon dictionnaire)
  PlanningMaintenance{intervention} to Intervention{planning}
}

// ─────────────────────────────────────────────────────────────────────────────
// OPTIONS DE GÉNÉRATION
// ─────────────────────────────────────────────────────────────────────────────

paginate Actif, Affectation, AffectationActif, Transfert, TransfertActif,
         Maintenance, Contrat, ServiceDgi, Agent, Bordereau,
         PlanningMaintenance, Intervention, Panne, Recensement,
         EquipementRecensement, HistoriqueAction, Inventaire, CategorieMateriel
         with pagination

dto * with mapstruct
service * with serviceImpl

filter Actif, Affectation, AffectationActif, Transfert, TransfertActif,
       Maintenance, ServiceDgi, Agent, Panne, Intervention,
       Recensement, EquipementRecensement, Bordereau, HistoriqueAction
